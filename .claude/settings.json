{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/validate_workspace.py)",
      "Bash(python3 -m unittest discover -s tests -v)",
      "Bash(python3 scripts/new_project.py *)",
      "Bash(python3 scripts/compile_scene_context.py *)",
      "Bash(python3 scripts/promote_candidate.py *)",
      "Bash(python3 scripts/hard_audit.py *)",
      "Bash(python3 scripts/defaultness_lint.py *)",
      "Bash(python3 scripts/revise_scene.py *)",
      "Bash(python3 scripts/assemble_manuscript.py *)",
      "Bash(python3 scripts/run_regression.py)",
      "Bash(python3 scripts/fiction_mcp.py)",
      "Bash(python3 -m unittest discover -s tests)",
      "Bash(make validate)",
      "Bash(make test)"
