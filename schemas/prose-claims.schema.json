{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prose-claims.schema.json",
  "comment": "Structured claims an extraction agent derives from ONE candidate's prose. Deterministic code (prose_audit) proves these against reconstructed state + the scene spec — the LLM extracts, the code judges (review §4).",
  "type": "object",
  "required": ["scene_id", "pov", "tense", "word_count", "claims"],
  "additionalProperties": false,
  "properties": {
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "candidate": {"type": "string"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pov": {"type": "string"},
    "tense": {"enum": ["past", "present", "future", "mixed"]},
    "word_count": {"type": "integer", "minimum": 0},
    "observed_events": {
      "type": "array",
      "comment": "Plan-blind extraction: events observed in the candidate, before seeing canonical event IDs.",
      "items": {
        "type": "object",
        "required": ["id", "description", "evidence", "consequential"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^observed-[a-z0-9-]+$"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "consequential": {"type": "boolean"}
        }
      }
    },
    "event_alignment": {
      "type": "array",
      "comment": "Plan-aware second pass: maps required canonical events to observed extraction, or records omitted/unverified.",
      "items": {
        "type": "object",
        "required": ["event_id", "status"],
        "additionalProperties": false,
        "properties": {
          "event_id": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"},
          "status": {"enum": ["realized", "omitted", "unverified"]},
          "observed_id": {"type": "string", "pattern": "^observed-[a-z0-9-]+$"},
          "note": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "evidence"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["character_present", "focalizer_knows", "focalizer_believes", "interiority_of", "located_at", "closes_promise", "states_fact"]},
          "subject": {"type": "string"},
          "object": {"type": "string"},
          "ref": {"type": "string"},
          "value": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
