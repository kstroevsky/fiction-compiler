{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selector-choice.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "scene_id", "pool_fingerprint", "selector",
    "candidate", "candidate_sha256", "provenance", "selected_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "experiment_id": {
      "type": "string",
      "pattern": "^selection-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"
    },
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "pool_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selector": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "candidate": {"type": "string", "pattern": "^[^/\\\\]+\\.md$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"type": "object"},
    "selected_at": {"type": "string", "minLength": 1}
  }
}
