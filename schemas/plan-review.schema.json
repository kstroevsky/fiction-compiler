{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scene_id", "plan_id", "plan_sha256", "reviewer", "verdict",
    "confidence", "findings", "easy_solution_assessments", "reviewed_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9][a-z0-9-]*$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "verdict": {"enum": ["pass", "revise", "reject", "uncertain"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "severity", "evidence", "diagnosis", "repair_layer"],
        "properties": {
          "dimension": {"type": "string", "minLength": 1},
          "severity": {"enum": ["minor", "material", "fatal"]},
          "evidence": {"type": "string", "minLength": 1},
          "diagnosis": {"type": "string", "minLength": 1},
          "repair_layer": {"enum": ["world", "character", "plot", "discourse", "scene", "prose"]}
        }
      }
    },
    "easy_solution_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["solution", "verdict", "reason"],
        "properties": {
          "solution": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["supported_conflict", "unsupported_conflict", "uncertain"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviewed_at": {"type": "string", "minLength": 1}
  }
}
