{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "post-revision-prose-audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "scene_id", "acceptance_object", "head_acceptance",
    "candidate_sha256", "bindings", "claims_sha256", "claims", "audit_result", "status",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "evidence_id": {"type": "string", "pattern": "^prose-recheck-[0-9a-f]{64}$"},
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "acceptance_object": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "head_acceptance": {"type": ["string", "null"]},
    "caused_by_scene": {"type": ["string", "null"]},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_sha256", "spec_sha256", "state_before_sha256", "state_delta_sha256",
        "audit_context_sha256"
      ],
      "properties": {
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state_delta_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audit_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "claims_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims": {"type": "object"},
    "audit_result": {"type": "object"},
    "status": {"enum": ["pass", "needs_attention"]},
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
