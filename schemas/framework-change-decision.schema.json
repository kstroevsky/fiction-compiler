{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-change-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "decision", "decided_by", "decider_kind", "reason", "evaluation_id", "framework_fingerprint", "comparison_summary", "proposal_sha256", "decided_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "change_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approve", "reject"]},
    "decided_by": {"type": "string", "minLength": 1},
    "decider_kind": {"enum": ["human"]},
    "reason": {"type": "string", "minLength": 1},
    "evaluation_id": {"type": ["string", "null"]},
    "framework_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "comparison_summary": {"type": "object"},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decided_at": {"type": "string", "minLength": 1}
  }
}
