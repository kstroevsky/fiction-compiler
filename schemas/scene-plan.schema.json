{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scene_id", "plan_id", "source_spec_sha256", "title", "tactic",
    "turn", "cost", "reader_learns", "required_events", "knowledge_required",
    "forbidden_moves", "easy_solution_checks"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9][a-z0-9-]*$"},
    "source_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "title": {"type": "string", "minLength": 1},
    "tactic": {"type": "string", "minLength": 1},
    "turn": {"type": "string", "minLength": 1},
    "cost": {"type": "string", "minLength": 1},
    "reader_learns": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_events": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"}
    },
    "knowledge_required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character", "fact"],
        "properties": {
          "character": {"type": "string", "pattern": "^char-[a-z0-9-]+$"},
          "fact": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"}
        }
      }
    },
    "forbidden_moves": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "easy_solution_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["solution", "available_information", "capability", "cost", "motive"],
        "properties": {
          "solution": {"type": "string", "minLength": 1},
          "available_information": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "cost": {"type": "string", "minLength": 1},
          "motive": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
