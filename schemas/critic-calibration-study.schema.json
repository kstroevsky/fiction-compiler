{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "critic-calibration-study.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "name", "source_corpus_sha256", "cases", "criteria", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "study_id": {"type": "string", "pattern": "^critic-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"},
    "name": {"type": "string", "minLength": 1},
    "source_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "critic", "kind", "signals", "expect_caught", "input", "input_sha256", "label_source", "source_kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "critic": {"type": "string"},
          "kind": {"enum": ["defect", "control"]},
          "signals": {"type": "array", "items": {"type": "string"}},
          "expect_caught": {"type": "boolean"},
          "input": {"type": "object"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "label_source": {"enum": ["provisional_fixture", "human_consensus", "public_benchmark"]},
          "source_kind": {"enum": ["local_control", "public_screening", "permissioned_control", "other"]}
        }
      }
    },
    "criteria": {"type": "object"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
