{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "critic-human-label.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "label_id", "case_id", "case_input_sha256", "annotator_id",
    "annotator_role", "label", "signals", "recorded_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "study_id": {"type": "string", "pattern": "^critic-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"},
    "label_id": {"type": "string", "pattern": "^label-[0-9a-f]{32}$"},
    "case_id": {"type": "string", "minLength": 1},
    "case_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotator_id": {"type": "string", "minLength": 1},
    "annotator_role": {"enum": ["expert", "target_reader", "owner", "other"]},
    "label": {"enum": ["defect", "control", "abstain", "disputed"]},
    "severity": {"enum": ["minor", "material", "fatal"]},
    "signals": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"},
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
