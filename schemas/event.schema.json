{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "type": "object",
  "required": ["id", "time", "actors", "preconditions", "action", "effects", "causes"],
  "properties": {
    "id": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"},
    "time": {"type": ["string", "number"]},
    "actors": {"type": "array", "items": {"type": "string"}},
    "preconditions": {
      "type": "array",
      "comment": "A precondition is a legacy prose string OR a typed atom {predicate, subject, object?}. Only typed atoms are machine-checked (hard_audit.audit_scene); prose atoms earn a migrate-to-typed advisory.",
      "items": {
        "type": ["string", "object"],
        "required": ["predicate", "subject"],
        "properties": {
          "predicate": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "object": {"type": "string"},
          "value": {},
          "comparison": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte"]}
        }
      }
    },
    "action": {"type": "string"},
    "effects": {
      "type": "array",
      "comment": "An effect is legacy prose, a typed predicate op, or a fact add/remove. Typed effects must be represented by the matching scene state-delta change and are executed in required_events order for linear scenes.",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["op", "predicate", "subject"],
            "properties": {
              "op": {"enum": ["add", "remove"]},
              "predicate": {"type": "string", "minLength": 1},
              "subject": {"type": "string", "minLength": 1},
              "object": {"type": "string"},
              "value": {}
            }
          },
          {
            "type": "object",
            "required": ["op", "fact"],
            "properties": {
              "op": {"enum": ["add", "remove"]},
              "fact": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"}
            }
          }
        ]
      }
    },
    "causes": {"type": "array", "items": {"type": "string"}},
    "revealed_to": {"type": "array", "items": {"type": "string"}},
    "cost": {"type": "string"}
  }
}
