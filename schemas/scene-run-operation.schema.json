{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-run-operation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "scene_id", "operation_id", "step_id", "phase",
    "status", "executor_kind", "recorded_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"},
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "operation_id": {"type": "string", "pattern": "^op-[0-9a-f]{32}$"},
    "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "phase": {"enum": ["generation", "critique", "revision", "selection", "reader", "promotion", "other"]},
    "status": {"enum": ["success", "failure"]},
    "executor_kind": {"enum": ["compiler", "human", "external_model", "role_runner", "unknown"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "snapshot"],
      "properties": {
        "name": {"type": "string", "pattern": "^[^/\\\\]+\\.md$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "snapshot": {"type": "string", "pattern": "^candidates/[0-9a-f]{64}\\.md$"}
      }
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "provider_request_id": {"type": "string", "minLength": 1},
    "response_model": {"type": "string", "minLength": 1},
    "finish_reason": {"type": "string", "minLength": 1},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "latency_ms": {"type": "number", "minimum": 0},
    "failure_reason": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
