{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "critique.schema.json",
  "type": "object",
  "required": ["candidate", "critic", "verdict", "findings", "confidence"],
  "properties": {
    "candidate": {"type": "string"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "critic": {"type": "string"},
    "audit_class": {"enum": ["hard", "literary", "defaultness"]},
    "verdict": {"enum": ["pass", "revise", "reject", "uncertain"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "run_id", "role", "vendor", "model", "candidate_sha256", "packet_sha256"],
      "properties": {
        "source": {"enum": ["role_runner"]},
        "run_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attempt_artifact": {"type": "string", "minLength": 1}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "severity", "evidence", "diagnosis", "repair_layer"],
        "properties": {
          "dimension": {"type": "string"},
          "severity": {"enum": ["minor", "material", "fatal"]},
          "evidence": {"type": "string", "minLength": 1},
          "diagnosis": {"type": "string"},
          "repair_layer": {"enum": ["brief", "world", "character", "plot", "discourse", "scene", "prose", "process"]}
        }
      }
    }
  }
}
