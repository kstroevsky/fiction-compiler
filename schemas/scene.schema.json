{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene.schema.json",
  "type": "object",
  "required": ["id", "chapter", "pov", "participants", "purpose", "entry_state", "desire", "conflict", "turn", "exit_state", "required_events", "forbidden_moves"],
  "properties": {
    "id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "chapter": {"type": "string"},
    "narrative_mode": {"enum": ["linear", "analepsis", "prolepsis"], "comment": "Discourse vs fabula: scene id is discourse (reading) order. 'analepsis' and 'prolepsis' mark a deliberate divergence. Absent = linear."},
    "fabula_time": {"type": ["string", "number"], "comment": "Planning-time story timestamp for historical/future state reconstruction. Required for analepsis/prolepsis; accepted state-delta.time is canonical and must match."},
    "pov": {"type": "string"},
    "participants": {"type": "array", "items": {"type": "string"}},
    "purpose": {"type": "array", "items": {"type": "string"}},
    "entry_state": {"type": "array", "items": {"type": "string"}},
    "desire": {"type": "string"},
    "conflict": {"type": "string"},
    "turn": {"type": "string"},
    "exit_state": {"type": "array", "items": {"type": "string"}},
    "required_events": {"type": "array", "items": {"type": "string"}},
    "event_references": {
      "type": "array",
      "comment": "Discourse-only appearances of canonical events whose world effects do not execute in this scene (for recollection, flashback replay, anticipation, summary, etc.).",
      "items": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"}
    },
    "forbidden_moves": {"type": "array", "items": {"type": "string"}},
    "style_constraints": {"type": "array", "items": {"type": "string"}},
    "candidate_strategies": {"type": "array", "items": {"type": "string"}},
    "knowledge_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character", "fact"],
        "properties": {
          "character": {"type": "string", "pattern": "^char-[a-z0-9-]+$"},
          "fact": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"}
        }
      }
    },
    "resource_requirements": {
      "type": "array",
      "comment": "Declare only quantities whose availability is load-bearing for the scene's action or turn.",
      "items": {
        "type": "object",
        "required": ["resource", "holder", "comparison", "quantity"],
        "additionalProperties": false,
        "properties": {
          "resource": {"type": "string", "pattern": "^res-[a-z0-9-]+$"},
          "holder": {"type": "string", "minLength": 1},
          "comparison": {"enum": ["at_least", "exactly"]},
          "quantity": {"type": "number", "minimum": 0},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["narrative_mode"],
        "properties": {"narrative_mode": {"enum": ["analepsis", "prolepsis"]}}
      },
      "then": {"required": ["fabula_time"]}
    }
  ]
}
