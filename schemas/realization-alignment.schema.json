{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "realization-alignment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "alignment_id", "case_id", "prose_sha256", "extraction_id", "aligner_family", "aligner_id", "event_alignment", "recorded_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "study_id": {"type": "string", "pattern": "^realization-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"},
    "alignment_id": {"type": "string", "pattern": "^align-[0-9a-f]{32}$"},
    "case_id": {"type": "string", "minLength": 1},
    "prose_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extraction_id": {"type": "string", "pattern": "^extract-[0-9a-f]{32}$"},
    "aligner_family": {"type": "string", "minLength": 1},
    "aligner_id": {"type": "string", "minLength": 1},
    "event_alignment": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "status"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"},
          "status": {"enum": ["realized", "omitted", "unverified"]},
          "observed_id": {"type": "string", "pattern": "^observed-[a-z0-9-]+$"},
          "note": {"type": "string"}
        }
      }
    },
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
