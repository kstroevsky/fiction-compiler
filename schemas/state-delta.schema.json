{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-delta.schema.json",
  "type": "object",
  "required": ["scene_id", "facts_added", "facts_removed", "knowledge_changes", "relationship_changes", "promises_opened", "promises_closed"],
  "properties": {
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "time": {"type": ["string", "number"]},
    "propositions_defined": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "facts_added": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "facts_removed": {"type": "array", "items": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"}},
    "knowledge_changes": {
      "type": "array",
      "comment": "Backward-compatible factive learning/forgetting. New work that needs mistaken belief, correction, provenance, or retained memory should use belief_changes.",
      "items": {
        "type": "object",
        "required": ["character", "fact"],
        "properties": {
          "op": {"enum": ["add", "remove"]},
          "character": {"type": "string", "pattern": "^char-[a-z0-9-]+$"},
          "fact": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"},
          "event": {"type": "string", "pattern": "^evt-[a-z0-9-]+$", "comment": "Optional source/provenance event; does not imply execution timing."},
          "at_event": {"type": "string", "pattern": "^evt-[a-z0-9-]+$", "comment": "Canonical event in this scene at which the state change becomes effective."}
        }
      }
    },
    "belief_changes": {
      "type": "array",
      "comment": "Per-character belief updates over stable proposition IDs. 'set' records a true/false stance and source; 'forget' removes retained memory and stance.",
      "items": {
        "type": "object",
        "required": ["op", "character", "fact"],
        "additionalProperties": false,
        "properties": {
          "op": {"enum": ["set", "forget"]},
          "character": {"type": "string", "pattern": "^char-[a-z0-9-]+$"},
          "fact": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"},
          "value": {"type": "boolean"},
          "source": {"enum": ["perception", "testimony", "inference", "correction", "forgetting", "unknown"]},
          "event": {"type": "string", "pattern": "^evt-[a-z0-9-]+$", "comment": "Optional source/provenance event; does not imply execution timing."},
          "at_event": {"type": "string", "pattern": "^evt-[a-z0-9-]+$", "comment": "Canonical event in this scene at which the state change becomes effective."}
        },
        "allOf": [
          {"if": {"properties": {"op": {"const": "set"}}}, "then": {"required": ["value", "source"]}},
          {"if": {"properties": {"op": {"const": "forget"}}}, "then": {"not": {"required": ["value"]}}}
        ]
      }
    },
    "relationship_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pair", "state"],
        "additionalProperties": false,
        "properties": {
          "pair": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
                   "items": {"type": "string", "pattern": "^char-[a-z0-9-]+$"}},
          "state": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "relationship_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "object", "dimension"],
        "additionalProperties": false,
        "properties": {
          "subject": {"type": "string", "pattern": "^char-[a-z0-9-]+$"},
          "object": {"type": "string", "pattern": "^char-[a-z0-9-]+$"},
          "dimension": {"type": "string", "minLength": 1},
          "value": {}
        }
      }
    },
    "predicate_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "predicate", "subject"],
        "additionalProperties": false,
        "properties": {
          "op": {"enum": ["add", "remove"]},
          "predicate": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "object": {"type": "string"},
          "value": {},
          "at_event": {"type": "string", "pattern": "^evt-[a-z0-9-]+$", "comment": "Canonical event in this scene at which the predicate change becomes effective."}
        }
      }
    },
    "resource_changes": {
      "type": "array",
      "comment": "Ordered changes for explicitly load-bearing countable resources. Transfer conserves tracked quantity; acquire/consume are explicit source/sink boundaries.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["op", "resource", "holder", "quantity"],
            "additionalProperties": false,
            "properties": {
              "op": {"enum": ["acquire", "consume"]},
              "resource": {"type": "string", "pattern": "^res-[a-z0-9-]+$"},
              "holder": {"type": "string", "minLength": 1},
              "quantity": {"type": "number", "exclusiveMinimum": 0},
              "unit": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "required": ["op", "resource", "from", "to", "quantity"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "transfer"},
              "resource": {"type": "string", "pattern": "^res-[a-z0-9-]+$"},
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1},
              "quantity": {"type": "number", "exclusiveMinimum": 0},
              "unit": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    },
    "promises_opened": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^promise-[a-z0-9-]+$"},
          "text": {"type": "string", "minLength": 1},
          "owed_by": {"type": "string"},
          "trigger_event": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"},
          "payoff_event": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"}
        }
      }
    },
    "promises_closed": {"type": "array", "items": {"type": "string", "pattern": "^promise-[a-z0-9-]+$"}}
  }
}
