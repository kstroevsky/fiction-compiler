{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-delta.schema.json",
  "type": "object",
  "required": ["scene_id", "facts_added", "facts_removed", "knowledge_changes", "relationship_changes", "promises_opened", "promises_closed"],
  "properties": {
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "time": {"type": ["string", "number"]},
    "facts_added": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "facts_removed": {"type": "array", "items": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"}},
    "knowledge_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character", "fact"],
        "properties": {
          "character": {"type": "string", "pattern": "^char-[a-z0-9-]+$"},
          "fact": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"}
        }
      }
    },
    "relationship_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pair", "state"],
        "properties": {
          "pair": {"type": "array", "items": {"type": "string", "pattern": "^char-[a-z0-9-]+$"}},
          "state": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "relationship_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "object", "dimension"],
        "properties": {
          "subject": {"type": "string", "pattern": "^char-[a-z0-9-]+$"},
          "object": {"type": "string", "pattern": "^char-[a-z0-9-]+$"},
          "dimension": {"type": "string", "minLength": 1},
          "value": {}
        }
      }
    },
    "predicate_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "predicate", "subject"],
        "properties": {
          "op": {"enum": ["add", "remove"]},
          "predicate": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "object": {"type": "string"},
          "value": {}
        }
      }
    },
    "promises_opened": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^promise-[a-z0-9-]+$"},
          "text": {"type": "string", "minLength": 1},
          "owed_by": {"type": "string"}
        }
      }
    },
    "promises_closed": {"type": "array", "items": {"type": "string", "pattern": "^promise-[a-z0-9-]+$"}}
  }
}
