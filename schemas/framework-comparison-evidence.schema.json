{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-comparison-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "comparison_id", "evaluator_kind", "evaluator_id", "preferred_label", "outcome", "rationale", "independent_of_agent_proposer", "recorded_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "change_id": {"type": "string", "minLength": 1},
    "comparison_id": {"type": "string", "minLength": 1},
    "evaluator_kind": {"enum": ["human", "model"]},
    "evaluator_id": {"type": "string", "minLength": 1},
    "preferred_label": {"enum": ["A", "B", "tie", "abstain"]},
    "outcome": {"enum": ["after", "before", "tie", "abstain"]},
    "rationale": {"type": "string", "minLength": 1},
    "independent_of_agent_proposer": {"type": "boolean"},
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
