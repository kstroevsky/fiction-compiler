{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pairwise-preference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "scene_id", "pool_fingerprint", "rater_id",
    "cohort_kind", "rater_kind", "pair_id", "left_label", "right_label", "choice",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "experiment_id": {
      "type": "string",
      "pattern": "^selection-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"
    },
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "pool_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rater_id": {"type": "string", "minLength": 1},
    "cohort_kind": {"enum": ["target_reader", "expert_reader", "owner", "other"]},
    "rater_kind": {"enum": ["human", "model_probe"]},
    "pair_id": {"type": "string", "pattern": "^pair-[0-9]{3}-(forward|reverse)$"},
    "left_label": {"type": "string", "pattern": "^[A-Z]$"},
    "right_label": {"type": "string", "pattern": "^[A-Z]$"},
    "choice": {"enum": ["left", "right", "tie", "abstain"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string"},
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
