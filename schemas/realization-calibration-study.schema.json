{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "realization-calibration-study.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "name", "source_corpus_sha256", "cases", "criteria", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "study_id": {"type": "string", "pattern": "^realization-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"},
    "name": {"type": "string", "minLength": 1},
    "source_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criteria": {"type": "object"},
    "created_at": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source_kind", "label_source", "prose", "prose_sha256", "required_events"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_kind": {"enum": ["local_control", "public_screening", "permissioned_control", "other"]},
          "label_source": {"enum": ["provisional_fixture", "human_consensus", "public_benchmark"]},
          "prose": {"type": "string", "minLength": 1},
          "prose_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "required_events": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["event_id", "description", "expected_status", "evidence_anchors"],
              "properties": {
                "event_id": {"type": "string", "pattern": "^evt-[a-z0-9-]+$"},
                "description": {"type": "string", "minLength": 1},
                "expected_status": {"enum": ["realized", "omitted"]},
                "evidence_anchors": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
