{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-change.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "title", "project", "proposal", "proposed_by", "proposer_kind", "changed_paths", "comparison_policy", "baseline", "snapshots", "started_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "change_id": {"type": "string", "pattern": "^framework-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"},
    "title": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_observed", "evidence", "root_layer", "minimal_change", "regression_case", "blind_comparison_plan", "tradeoffs", "human_approval_status"],
      "properties": {
        "failure_observed": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "root_layer": {"type": "string", "minLength": 1},
        "minimal_change": {"type": "string", "minLength": 1},
        "regression_case": {"type": "string", "minLength": 1},
        "blind_comparison_plan": {"type": "string", "minLength": 1},
        "tradeoffs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "human_approval_status": {"enum": ["pending"]}
      }
    },
    "proposed_by": {"type": "string", "minLength": 1},
    "proposer_kind": {"enum": ["human", "agent"]},
    "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_observations", "minimum_after_wins", "maximum_before_wins"],
      "properties": {
        "minimum_observations": {"type": "integer", "minimum": 1},
        "minimum_after_wins": {"type": "integer", "minimum": 0},
        "maximum_before_wins": {"type": "integer", "minimum": 0}
      }
    },
    "baseline": {
      "type": "object",
      "required": ["regression", "framework_files"],
      "properties": {
        "regression": {"type": "object"},
        "framework_files": {"type": "object"}
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "exists": {"type": "boolean"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "backup": {"type": "string", "minLength": 1}
        }
      }
    },
    "started_at": {"type": "string", "minLength": 1}
  }
}
