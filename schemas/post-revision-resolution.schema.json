{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "post-revision-resolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_id", "evidence_id", "scope", "decided_by", "reason", "resolved_scenes", "resolved_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "resolution_id": {"type": "string", "pattern": "^resolve-[0-9a-f]{64}$"},
    "evidence_id": {"type": "string", "pattern": "^recheck-[0-9a-f]{64}$"},
    "scope": {"enum": ["literary", "reader", "voice", "whole_work"]},
    "target_scene": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "decided_by": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "resolved_scenes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"}},
    "resolved_at": {"type": "string", "minLength": 1}
  }
}
