{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selection-pool.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "scene_id", "seed", "pool_fingerprint",
    "candidates", "pairs", "created_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "experiment_id": {
      "type": "string",
      "pattern": "^selection-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"
    },
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "seed": {"type": "integer"},
    "pool_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "sha256", "generation_index", "blind_label"],
        "properties": {
          "candidate": {"type": "string", "pattern": "^[^/\\\\]+\\.md$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "generation_index": {"type": "integer", "minimum": 0},
          "blind_label": {"type": "string", "pattern": "^[A-Z]$"}
        }
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "left_label", "right_label"],
        "properties": {
          "pair_id": {"type": "string", "pattern": "^pair-[0-9]{3}-(forward|reverse)$"},
          "left_label": {"type": "string", "pattern": "^[A-Z]$"},
          "right_label": {"type": "string", "pattern": "^[A-Z]$"}
        }
      }
    },
    "created_at": {"type": "string", "minLength": 1}
  }
}
