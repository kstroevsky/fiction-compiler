{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "realization-extraction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "extraction_id", "case_id", "prose_sha256", "extractor_family", "extractor_id", "trial_index", "observed_events", "recorded_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "study_id": {"type": "string", "pattern": "^realization-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"},
    "extraction_id": {"type": "string", "pattern": "^extract-[0-9a-f]{32}$"},
    "case_id": {"type": "string", "minLength": 1},
    "prose_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extractor_family": {"type": "string", "minLength": 1},
    "extractor_id": {"type": "string", "minLength": 1},
    "trial_index": {"type": "integer", "minimum": 1},
    "observed_events": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "evidence", "consequential"],
        "properties": {
          "id": {"type": "string", "pattern": "^observed-[a-z0-9-]+$"},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "consequential": {"type": "boolean"}
        }
      }
    },
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
