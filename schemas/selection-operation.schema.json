{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selection-operation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "scene_id", "pool_fingerprint", "operation_id",
    "phase", "status", "recorded_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "experiment_id": {
      "type": "string",
      "pattern": "^selection-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"
    },
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "pool_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_id": {"type": "string", "pattern": "^op-[0-9a-f]{32}$"},
    "phase": {"enum": ["generation", "critique", "selection", "reader", "revision", "other"]},
    "status": {"enum": ["success", "failure"]},
    "candidate": {"type": "string", "pattern": "^[^/\\\\]+\\.md$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "failure_reason": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
