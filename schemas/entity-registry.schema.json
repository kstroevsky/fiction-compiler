{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity-registry.schema.json",
  "type": "object",
  "required": ["closed_types", "entities"],
  "additionalProperties": false,
  "properties": {
    "closed_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"}
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*-[a-z0-9][a-z0-9-]*$"},
          "type": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
          "label": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
