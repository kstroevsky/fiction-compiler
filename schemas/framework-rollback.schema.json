{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-rollback.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "decided_by", "decider_kind", "reason", "from_evaluation_id", "restored_fingerprint", "baseline_fingerprint", "baseline_restored", "regression_ok", "rolled_back_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "change_id": {"type": "string", "minLength": 1},
    "decided_by": {"type": "string", "minLength": 1},
    "decider_kind": {"enum": ["human"]},
    "reason": {"type": "string", "minLength": 1},
    "from_evaluation_id": {"type": "string", "minLength": 1},
    "restored_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_restored": {"type": "boolean"},
    "regression_ok": {"type": "boolean"},
    "rolled_back_at": {"type": "string", "minLength": 1}
  }
}
