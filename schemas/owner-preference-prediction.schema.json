{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owner-preference-prediction.schema.json",
  "type": "object",
  "required": ["schema_version", "prediction_id", "preference_id", "preference_sha256", "packet_sha256", "project_id", "critic", "prediction", "recorded_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "prediction_id": {"type": "string", "pattern": "^prediction-[0-9a-f]{32}$"},
    "preference_id": {"type": "string", "pattern": "^pref-[0-9a-f]{32}$"},
    "preference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "critic": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "prediction": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["pick", "abstain"]},
        "alternative_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "pick"}}},
          "then": {"required": ["alternative_id"]}
        },
        {
          "if": {"properties": {"kind": {"const": "abstain"}}},
          "then": {"not": {"required": ["alternative_id"]}}
        }
      ]
    },
    "provenance": {"type": "object"},
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
