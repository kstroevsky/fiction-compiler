{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-selection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scene_id", "selection_id", "batch_fingerprint", "selected_plans",
    "decided_by", "reason", "selected_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "scene_id": {"type": "string", "pattern": "^ch[0-9]{2}-sc[0-9]{2}$"},
    "selection_id": {"type": "string", "pattern": "^selection-[0-9]{8}T[0-9]{12}Z-[0-9a-f]{12}$"},
    "batch_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_plans": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plan_id", "sha256"],
        "properties": {
          "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9][a-z0-9-]*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "decided_by": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "selected_at": {"type": "string", "minLength": 1}
  }
}
