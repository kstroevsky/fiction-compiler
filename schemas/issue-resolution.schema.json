{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-resolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "finding_id", "relationship", "applicability", "resolution", "reason", "decided_by", "source", "target"],
  "properties": {
    "version": {"enum": ["issue-resolution@1"]},
    "finding_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relationship": {"enum": ["predecessor", "sibling"]},
    "applicability": {"enum": ["applies", "does_not_apply"]},
    "resolution": {"enum": ["resolved", "rechecked", "waived", "adjudicated", "open"]},
    "reason": {"type": "string", "minLength": 1},
    "decided_by": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critique_file", "critique_sha256", "candidate", "candidate_sha256", "critic"],
      "properties": {
        "critique_file": {"type": "string", "minLength": 1},
        "critique_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate": {"type": "string", "minLength": 1},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "critic": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "candidate_sha256"],
      "properties": {
        "candidate": {"type": "string", "minLength": 1},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
