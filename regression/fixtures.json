{
  "_comment": "Fixed framework-regression fixtures. Each pins a deterministic invariant an ADR established. Run with scripts/run_regression.py; a failure means a framework change regressed an invariant and must be rejected or rolled back.",
  "fixtures": [
    {
      "name": "defaultness catches a stock cliché (ADR pre-0004 linter)",
      "check": "defaultness_verdict",
      "input": {"text": "Her heart pounded and time stood still as little did she know."},
      "expect": "revise"
    },
    {
      "name": "defaultness passes concrete, unhedged prose",
      "check": "defaultness_verdict",
      "input": {"text": "The relay lay open, two wires bright against the salt."},
      "expect": "pass"
    },
    {
      "name": "revision rejects the count-drop trap: 2 minors -> 1 new material (ADR 0009)",
      "check": "revision_decision",
      "input": {
        "before": [{"findings": [
          {"dimension": "cliche", "severity": "minor", "evidence": "heart pounded"},
          {"dimension": "cliche", "severity": "minor", "evidence": "time stood still"}]}],
        "after": [{"findings": [
          {"dimension": "cliche", "severity": "material", "evidence": "a wholly new default"}]}],
        "target": "cliche"
      },
      "expect": "reject_regression"
    },
    {
      "name": "revision accepts a clean, identity-resolved target fix (ADR 0009)",
      "check": "revision_decision",
      "input": {
        "before": [{"findings": [{"dimension": "cliche", "severity": "material", "evidence": "heart pounded"}]}],
        "after": [{"findings": []}],
        "target": "cliche"
      },
      "expect": "accept"
    },
    {
      "name": "revision accepts a waived deliberate regression (ADR 0009)",
      "check": "revision_decision",
      "input": {
        "before": [{"findings": [{"dimension": "cliche", "severity": "material", "evidence": "heart pounded"}]}],
        "after": [{"findings": [{"dimension": "style", "severity": "material", "evidence": "a deliberate genre flourish"}]}],
        "target": "cliche",
        "waivers": [{"dimension": "style", "evidence": "a deliberate genre flourish", "reason": "genre obligation", "approved_by": "human"}]
      },
      "expect": "accept"
    },
    {
      "name": "tournament defers a genuine style-vs-cliche tradeoff (ADR 0007)",
      "check": "tournament_decision",
      "input": {"critiques": [
        {"candidate": "a.md", "findings": [{"dimension": "style", "severity": "material"}]},
        {"candidate": "b.md", "findings": [{"dimension": "cliche", "severity": "material"}]}]},
      "expect": "human_decision_required"
    },
    {
      "name": "tournament selects a clean dominator (ADR 0007)",
      "check": "tournament_decision",
      "input": {"critiques": [
        {"candidate": "a.md", "findings": []},
        {"candidate": "b.md", "findings": [{"dimension": "cliche", "severity": "material"}]}]},
      "expect": "select"
    },
    {
      "name": "tournament ignores the scene-level hard audit as a phantom candidate",
      "check": "tournament_decision",
      "input": {"critiques": [
        {"candidate": "ch01-sc02", "critic": "hard-audit", "findings": []},
        {"candidate": "candidate-a.md", "findings": []},
        {"candidate": "candidate-b.md", "findings": [{"dimension": "cliche", "severity": "material"}]}]},
      "expect": "select"
    },
    {
      "name": "ontology rejects a predicate typo (ADR 0005)",
      "check": "ontology_valid",
      "input": {
        "ontology": {"predicates": [{"name": "located_at", "arity": "binary", "subject_types": ["char"], "object_types": ["loc"]}]},
        "atom": {"predicate": "located_att", "subject": "char-jonas", "object": "loc-station"}
      },
      "expect": false
    },
    {
      "name": "ontology accepts a declared, well-typed atom (ADR 0005)",
      "check": "ontology_valid",
      "input": {
        "ontology": {"predicates": [{"name": "located_at", "arity": "binary", "subject_types": ["char"], "object_types": ["loc"]}]},
        "atom": {"predicate": "located_at", "subject": "char-jonas", "object": "loc-station"}
      },
      "expect": true
    },
    {
      "name": "prose audit flags a focalizer knowing an ungranted fact (ADR 0014, review §4)",
      "check": "prose_knowledge_leak",
      "input": {"pov_knows_before": false, "granted_this_scene": false},
      "expect": true
    },
    {
      "name": "prose audit allows the focalizer to perceive a fact this scene grants (ADR 0014)",
      "check": "prose_knowledge_leak",
      "input": {"pov_knows_before": false, "granted_this_scene": true},
      "expect": false
    },
    {
      "name": "tournament floor excludes a candidate with a material code-audit finding (ADR 0016)",
      "check": "tournament_selected",
      "input": {"critiques": [
        {"candidate": "candidate-a.md", "critic": "defaultness-lint", "findings": []},
        {"candidate": "candidate-b.md", "critic": "defaultness-lint", "findings": [{"dimension": "cliche", "severity": "material"}]}]},
      "expect": "candidate-a.md"
    },
    {
      "name": "tournament reports no eligible candidate when all fail the deterministic floor (ADR 0016)",
      "check": "tournament_selected",
      "input": {"critiques": [
        {"candidate": "candidate-a.md", "critic": "defaultness-lint", "findings": [{"dimension": "x", "severity": "material"}]},
        {"candidate": "candidate-b.md", "critic": "prose-audit", "findings": [{"dimension": "y", "severity": "fatal"}]}]},
      "expect": "no_eligible_candidates"
    },
    {
      "name": "premise divergence floor rejects a batch collapsed to one architecture (ADR 0017)",
      "check": "premise_diversity",
      "input": {"candidates": [
        {"id": "p1", "logline": "A woman confronts a rival.", "pov_character": "char-a", "transforming_character": "char-b", "conflict_type": "interpersonal", "obliqueness": "direct", "resolution_type": "clever", "theme_question": "who wins?", "why_not_default": "n/a"},
        {"id": "p2", "logline": "A man confronts a rival.", "pov_character": "char-c", "transforming_character": "char-d", "conflict_type": "interpersonal", "obliqueness": "direct", "resolution_type": "clever", "theme_question": "who wins?", "why_not_default": "n/a"},
        {"id": "p3", "logline": "A stranger confronts a rival.", "pov_character": "char-e", "transforming_character": "char-f", "conflict_type": "interpersonal", "obliqueness": "direct", "resolution_type": "clever", "theme_question": "who wins?", "why_not_default": "n/a"}]},
      "expect": false
    },
    {
      "name": "premise divergence floor accepts three distinct architectures (ADR 0017)",
      "check": "premise_diversity",
      "input": {"candidates": [
        {"id": "p1", "logline": "A barman stays sober through one shift.", "pov_character": "char-a", "transforming_character": "char-a", "conflict_type": "internal", "obliqueness": "oblique", "resolution_type": "humble", "theme_question": "can he stand in the place that unmade him?", "why_not_default": "not the fall or the confession"},
        {"id": "p2", "logline": "A farmhand brings the flock down before a storm.", "pov_character": "char-b", "transforming_character": "char-b", "conflict_type": "character-vs-nature", "obliqueness": "direct", "resolution_type": "humble", "theme_question": "will she trust her own read of the weather?", "why_not_default": "no triumphant rescue"},
        {"id": "p3", "logline": "A visitor withholds one sentence across a prison table.", "pov_character": "char-c", "transforming_character": "char-c", "conflict_type": "interpersonal", "obliqueness": "oblique", "resolution_type": "refusal", "theme_question": "is a kind lie a betrayal?", "why_not_default": "no confession or catharsis"}]},
      "expect": true
    },
    {
      "name": "record_critique refuses a pass that carries a material finding (ADR 0018)",
      "check": "critique_consistency",
      "input": {"verdict": "pass", "findings": [{"dimension": "cliche", "severity": "material", "evidence": "heart pounded"}]},
      "expect": false
    },
    {
      "name": "record_critique accepts a clean pass (ADR 0018)",
      "check": "critique_consistency",
      "input": {"verdict": "pass", "findings": []},
      "expect": true
    },
    {
      "name": "record_critique allows a revise to carry a material finding (ADR 0018)",
      "check": "critique_consistency",
      "input": {"verdict": "revise", "findings": [{"dimension": "cliche", "severity": "material", "evidence": "heart pounded"}]},
      "expect": true
    }
  ]
}
